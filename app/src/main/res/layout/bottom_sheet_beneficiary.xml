<?xml version="1.0" encoding="utf-8"?>
<!-- Modal bottom sheet content. The sheet background, rounded corners and half-screen
     height come from the theme (Widget.Mukono.BottomSheet.Half). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/dragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_handle"/>

        <!-- Profile header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInitials"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/mk_avatar_bg"
                android:gravity="center"
                android:text="@string/sample_initials"
                android:textColor="@color/mk_green_dark"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBeneficiaryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_beneficiary_name"
                    android:textColor="@color/mk_text"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvBeneficiaryRole"
                    style="@style/Mk.Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/beneficiary_role"
                    android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Details card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/mk_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mk_card_stroke"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        style="@style/Mk.Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/household_size_label"/>

                    <TextView
                        android:id="@+id/tvHouseholdSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_household_size"
                        android:textColor="@color/mk_text"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:background="@color/mk_card_stroke"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/tvDietaryLabel"
                        style="@style/Mk.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dietary_restrictions_label"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDiet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="6dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDietHalal"
                            style="@style/Mk.Chip.Diet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="@string/diet_halal"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDietDiabetic"
                            style="@style/Mk.Chip.Diet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="@string/diet_diabetic"/>
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PRIMARY action: solid green with white text and a check icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDelivery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_confirm_delivery"
            android:textAllCaps="false"
            android:textColor="@color/mk_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/mk_green"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/mk_white"/>

        <!-- SECONDARY action: same size, but outlined with no fill and a flag icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportIssue"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_report_issue"
            android:textAllCaps="false"
            android:textColor="@color/mk_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_flag"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/mk_text"
            app:strokeColor="@color/mk_outline"
            app:strokeWidth="2dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
