<?xml version="1.0" encoding="utf-8"?>
<!-- Second bottom sheet. The theme (Widget.Mukono.BottomSheet.Locked) makes it impossible to
     dismiss by swiping, so the text field can scroll and be typed in without closing the sheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/dragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_handle"/>

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:textColor="@color/mk_text"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvReportBeneficiary"
            style="@style/Mk.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_beneficiary_name"/>

        <TextView
            style="@style/Mk.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/report_what_went_wrong"
            android:textSize="15sp"/>

        <RadioGroup
            android:id="@+id/rgIssueType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbWrongPerson"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_card"
                android:checked="false"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/issue_wrong_person"
                android:textColor="@color/mk_text"
                android:textSize="18sp"
                app:buttonTint="@color/radio_tint"/>
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbAddressChanged"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_card"
                android:checked="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/issue_address_changed"
                android:textColor="@color/mk_text"
                android:textSize="18sp"
                app:buttonTint="@color/radio_tint"/>
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNoShow"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_card"
                android:checked="false"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/issue_no_show"
                android:textColor="@color/mk_text"
                android:textSize="18sp"
                app:buttonTint="@color/radio_tint"/>
        </RadioGroup>

        <TextView
            style="@style/Mk.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/report_details_label"
            android:textSize="15sp"/>

        <!-- Long text field: the border turns green while typing -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDetails"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="@color/field_stroke"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/report_details_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:textColor="@color/mk_text"
                android:textColorHint="@color/mk_text_secondary"
                android:textSize="18sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PRIMARY action: solid green -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_submit_report"
            android:textAllCaps="false"
            android:textColor="@color/mk_white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/mk_green"
            app:cornerRadius="20dp"/>

        <!-- SECONDARY action: outlined, no fill -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="@color/mk_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeColor="@color/mk_outline"
            app:strokeWidth="2dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
