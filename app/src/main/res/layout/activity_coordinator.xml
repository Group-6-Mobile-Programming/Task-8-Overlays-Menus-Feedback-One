<?xml version="1.0" encoding="utf-8"?>
<!-- Map with a side sheet (delivery manifest) sliding in from the right edge.
     The map stays visible and usable behind it. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mk_map_bg">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/map_placeholder_description">

        <!-- Placeholder picture. The logic team puts the real map here. -->
        <ImageView
            android:id="@+id/ivMapPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_map_placeholder"/>

        <!-- Tap to open the manifest again after closing it -->
        <LinearLayout
            android:id="@+id/cardMapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_map_card"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvMapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_title"
                android:textColor="@color/mk_text"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMapCity"
                style="@style/Mk.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_city"
                android:textSize="13sp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Side sheet: starts hidden, slides in from the right -->
    <FrameLayout
        android:id="@+id/sideSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_side_sheet"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.sidesheet.SideSheetBehavior">

        <include layout="@layout/view_manifest_content"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
