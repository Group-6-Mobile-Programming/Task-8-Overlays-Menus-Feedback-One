<?xml version="1.0" encoding="utf-8"?>
<!-- One stop in the manifest.
     tvStatus default is "Pending" (outlined pill). For "Delivered": background bg_pill_delivered,
     text colour mk_green_dark and a check icon as drawableStart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvStopNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_green"
            android:gravity="center"
            android:textColor="@color/mk_white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBeneficiaryNameRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mk_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Nakato Grace"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_pending"
                    android:drawablePadding="4dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mk_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Pending"/>

                <TextView
                    android:id="@+id/tvHouseholdRow"
                    style="@style/Mk.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    tools:text="6 people"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Reassign volunteer. Use R.layout.spinner_item and spinner_dropdown_item in the adapter. -->
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinnerVolunteer"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:paddingEnd="32dp"
            android:spinnerMode="dropdown"/>
    </LinearLayout>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mk_divider"/>
</LinearLayout>
