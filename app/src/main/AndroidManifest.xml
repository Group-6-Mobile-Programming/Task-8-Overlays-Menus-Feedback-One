<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mukono">

        <!-- Volunteer: scan QR code, bottom sheets -->
        <activity
            android:name=".ScanActivity"
            android:exported="true"
            android:label="@string/label_volunteer"
            android:theme="@style/Theme.Mukono.Scan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Coordinator (tablet): map with delivery manifest side sheet.
             Has its own launcher entry so each screen can be tested. -->
        <activity
            android:name=".CoordinatorActivity"
            android:exported="true"
            android:label="@string/label_coordinator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
